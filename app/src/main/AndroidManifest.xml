<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Accelerometer and rotation vector are "normal" sensors: no runtime
         permission is required to read them on Android. We only declare the
         hardware feature requirement so the Play Store / package manager can
         filter out devices without an accelerometer. Rotation vector is a
         software/fused sensor on many devices (composed from accelerometer +
         magnetometer/gyroscope), so we do not mark it as a required feature:
         some devices without a magnetometer still synthesize a rotation
         vector from gyroscope + accelerometer, and we don't want to
         needlessly exclude those devices from the Play Store listing. -->
    <uses-feature
        android:name="android.hardware.sensor.accelerometer"
        android:required="true" />

    <!-- Permiso NORMAL (se concede automaticamente al instalar, sin
         dialogo de runtime) requerido desde Android 12 (API 31) para
         pedir sensores a la tasa mas rapida sin limite (SENSOR_DELAY_
         FASTEST / "0 microsegundos" de delay). Sin esto, registrar un
         listener con esa tasa lanza SecurityException y crashea la app
         al abrir (visto en pruebas reales). El motor de deteccion fue
         calibrado con datos del Poco M7 4G a ~400-460Hz, pero esa era la
         tasa que el logger entregaba SIN este permiso; el hardware
         real soporta mas, y preferimos no perder resolucion disponible
         en el dispositivo en vez de limitarla artificialmente a un valor
         fijo en codigo. -->
    <uses-permission android:name="android.permission.HIGH_SAMPLING_RATE_SENSORS" />

    <!-- Solo necesario en API 26-28 (maxSdkVersion=28): el logger de
         sesiones de Play (PlaySessionLogger) usa MediaStore.Downloads en
         API 29+ (Q, scoped storage), que no requiere este permiso. Para el
         fallback legacy en versiones mas viejas (minSdk=26) si hace falta
         para escribir directo en la carpeta publica de Descargas. En API
         29+ el sistema ignora este permiso por el maxSdkVersion, asi que
         no se pide ningun dialogo de runtime en dispositivos modernos. -->
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.AirPulse">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:screenOrientation="portrait">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>
